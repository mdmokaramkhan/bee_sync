# Pub uses this file instead of .gitignore, so it repeats .gitignore's rules.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Private research notes, kept locally only.
/deep-research-report.md

# Development-only: tests, tooling and benchmarks live in the repository,
# not in the published package.
/test/
/android/src/test/
/benchmark/
/tool/
/pigeons/
/example/integration_test/
